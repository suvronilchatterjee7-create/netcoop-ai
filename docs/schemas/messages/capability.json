{
  "$defs": {
    "AgentRole": {
      "enum": [
        "translator",
        "specialist",
        "correlator",
        "adjudicator",
        "reporter",
        "external"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "CapabilityCard": {
      "additionalProperties": false,
      "properties": {
        "activation_metrics": {
          "default": [],
          "description": "Agent runs only if at least one of these metrics is observed (empty = always).",
          "items": {
            "type": "string"
          },
          "title": "Activation Metrics",
          "type": "array"
        },
        "agent_id": {
          "description": "Unique agent identifier; used as `sender`/`recipient`.",
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Agent Id",
          "type": "string"
        },
        "consumes_metrics": {
          "default": [],
          "description": "Canonical metrics it analyses ('*' = all).",
          "items": {
            "type": "string"
          },
          "title": "Consumes Metrics",
          "type": "array"
        },
        "consumes_types": {
          "description": "Message types the agent wants delivered.",
          "items": {
            "$ref": "#/$defs/MessageType"
          },
          "title": "Consumes Types",
          "type": "array"
        },
        "description": {
          "description": "What the agent is responsible for.",
          "title": "Description",
          "type": "string"
        },
        "hypothesis_types": {
          "default": [],
          "description": "Hypothesis types it may propose.",
          "items": {
            "type": "string"
          },
          "title": "Hypothesis Types",
          "type": "array"
        },
        "optional": {
          "default": false,
          "description": "If true, absence or inactivity does not lower confidence.",
          "title": "Optional",
          "type": "boolean"
        },
        "produces_types": {
          "description": "Message types the agent may emit.",
          "items": {
            "$ref": "#/$defs/MessageType"
          },
          "title": "Produces Types",
          "type": "array"
        },
        "protocol_versions": {
          "description": "Protocol versions the agent can speak.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Protocol Versions",
          "type": "array"
        },
        "role": {
          "$ref": "#/$defs/AgentRole",
          "description": "Kind of agent."
        },
        "serves": {
          "default": [],
          "description": "REQUEST capabilities it answers: 'metric:<name>', 'analysis:<name>', or 'metric:*' (any metric in consumes_metrics).",
          "items": {
            "type": "string"
          },
          "title": "Serves",
          "type": "array"
        },
        "version": {
          "description": "Agent implementation version (semver).",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "version",
        "role",
        "description",
        "protocol_versions",
        "consumes_types",
        "produces_types"
      ],
      "title": "CapabilityCard",
      "type": "object"
    },
    "CapabilityPayload": {
      "additionalProperties": false,
      "properties": {
        "card": {
          "$ref": "#/$defs/CapabilityCard",
          "description": "The sender's capability card."
        }
      },
      "required": [
        "card"
      ],
      "title": "CapabilityPayload",
      "type": "object"
    },
    "MessageType": {
      "enum": [
        "OBSERVATION",
        "TOPOLOGY",
        "CLUE",
        "HYPOTHESIS",
        "SUPPORT",
        "CONTRADICT",
        "REQUEST",
        "RESPONSE",
        "ERROR",
        "ACK",
        "CAPABILITY",
        "VERDICT",
        "REPORT"
      ],
      "title": "MessageType",
      "type": "string"
    }
  },
  "$id": "netcoop/2.0/messages/capability.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Capability-card announcement.",
  "properties": {
    "adaptations": {
      "default": [],
      "description": "Version conversions applied, e.g. '1.0->2.0', and any lossy fields.",
      "items": {
        "type": "string"
      },
      "title": "Adaptations",
      "type": "array"
    },
    "causation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "msg_id of the message that caused this one (null = root).",
      "title": "Causation Id"
    },
    "correlation_id": {
      "description": "Incident id shared by every message of one diagnosis run.",
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "depth": {
      "default": 0,
      "description": "Causation depth: 0 for roots, parent depth + 1 otherwise.",
      "minimum": 0,
      "title": "Depth",
      "type": "integer"
    },
    "msg_id": {
      "description": "Unique message id; content hash when built by make_message.",
      "minLength": 1,
      "title": "Msg Id",
      "type": "string"
    },
    "payload": {
      "$ref": "#/$defs/CapabilityPayload",
      "description": "Capability card."
    },
    "protocol": {
      "const": "netcoop",
      "default": "netcoop",
      "description": "Protocol name; always 'netcoop'.",
      "title": "Protocol",
      "type": "string"
    },
    "protocol_version": {
      "const": "2.0",
      "default": "2.0",
      "description": "Wire-format version of this message.",
      "title": "Protocol Version",
      "type": "string"
    },
    "recipient": {
      "default": "board",
      "description": "agent_id of the recipient, or 'board' for a shared post.",
      "title": "Recipient",
      "type": "string"
    },
    "schema_version": {
      "description": "Controlled-vocabulary version the payload's terms refer to.",
      "title": "Schema Version",
      "type": "string"
    },
    "sender": {
      "description": "agent_id of the sender.",
      "minLength": 1,
      "title": "Sender",
      "type": "string"
    },
    "timestamp": {
      "description": "Creation time, ISO-8601 UTC (excluded from msg_id).",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "type": {
      "const": "CAPABILITY",
      "default": "CAPABILITY",
      "description": "Message type.",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "msg_id",
    "correlation_id",
    "sender",
    "timestamp",
    "payload"
  ],
  "title": "CapabilityMessage",
  "type": "object"
}
